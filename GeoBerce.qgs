<rule key="{f1060286-839c-4e6d-9635-5aabe450b2f0}" filter="lower(&quot;paper&quot;) LIKE 'y%'" symbol="3" label="Point de tri (papier)"/>
<rule key="{95df1a7d-70bf-45fe-88d3-55fd3df753b9}" filter="lower(&quot;plastic_packaging&quot;) LIKE 'y%'" symbol="4" label="Point de tri (emballages)"/>
