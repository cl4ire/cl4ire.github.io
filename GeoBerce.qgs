<layername>Déchèteries / tri</layername>
<provider encoding="UTF-8">ogr</provider>
<renderer-v2 type="RuleRenderer" symbollevels="0" enableorderby="0" forceraster="0" referencescale="-1">
<rules key="{92d776be-f1fe-4969-a00e-3954f98ab59f}">
<rule key="{8bedef43-beb7-4893-a77d-685fb15899f7}" filter="&quot;type&quot; = 'centre'" symbol="0" label="Déchèterie"/>
<rule key="{885c2040-260f-4731-a86e-c509da2d9746}" filter="&quot;type&quot; = 'compost'" symbol="1" label="Composteur partagé"/>
