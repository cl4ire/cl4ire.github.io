<layername>Déchèteries / tri</layername>
<provider encoding="UTF-8">ogr</provider>
<renderer-v2 type="RuleRenderer" symbollevels="0" enableorderby="0" forceraster="0" referencescale="-1">
<rules key="{4a2503bf-f0a9-4548-a267-f97b68fa0cbd}">
<rule key="{45fe1d10-65cc-4014-b2c1-710b7b4bb540}" filter="&quot;type&quot; = 'centre'" symbol="0" label="Déchèterie"/>
<rule key="{85d13847-18c1-4dc7-9e5f-33b54d2fd5fc}" filter="&quot;type&quot; = 'compost'" symbol="1" label="Composteur partagé"/>
<rule key="{2ba63df7-3d80-4b1a-bfa9-6829a50048b4}" filter="lower(&quot;glass&quot;) LIKE 'y%'" symbol="2" label="Point de tri (verre)"/>
<rule key="{0532dc74-8a8c-4733-897a-690e94bcb918}" filter="lower(&quot;paper&quot;) LIKE 'y%'" symbol="3" label="Point de tri (papier)"/>
<rule key="{39cc4641-42f6-473a-bd6b-0ea1699344f6}" filter="lower(&quot;plastic_packaging&quot;) LIKE 'y%'" symbol="4" label="Point de tri (emballages)"/>
